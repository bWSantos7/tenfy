# Example environment for backend/.env.example. Use placeholders only.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://www.tennis.app.br,https://api.tennis.app.br
CORS_ALLOWED_ORIGINS=https://www.tennis.app.br
DATABASE_URL=postgresql://user:password@host:5432/dbname
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_TOKEN=
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=
IMPORT_API_TOKEN=
TENNIS_IMPORT_TOKEN=
COSAT_MONGO_URL=mongodb+srv://user:password@cluster.example.mongodb.net
COSAT_MONGO_DB=cosat
COSAT_MONGO_ENABLED=false
COSAT_MONGO_COLLECTION_TOURNAMENTS=tournaments
COSAT_MONGO_COLLECTION_ENTRIES=entries
COSAT_MONGO_COLLECTION_RANKINGS=rankings
COSAT_MONGO_CONNECT_TIMEOUT_MS=5000
FRONTEND_URL=https://www.tennis.app.br
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
REDIS_URL=redis://default:password@host:6379
RESEND_API_KEY=re_...
DEFAULT_FROM_EMAIL=no-reply@tennis.app.br
RESEND_FROM_EMAIL=no-reply@tennis.app.br
SCRAPER_USER_AGENT=TennisHubBot/1.0
SCRAPER_TIMEOUT=30
SCRAPER_RATE_LIMIT_SECONDS=2
SECURE_SSL_REDIRECT=False
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=no-reply@tennis.app.br
CLOUDINARY_URL=cloudinary://...
