# Tennis Hub - isolated backend test environment
#
# Copy this file to .env.test or export these variables in your shell before
# running backend tests. Do not use Railway, production, staging, proxy hosts,
# or any shared database for test execution.

DEBUG=False
SECRET_KEY=change-me-for-local-tests-only

# Required: local/isolated PostgreSQL database created only for tests.
# Safe examples:
#   postgresql://postgres:postgres@localhost:5432/tennis_hub_test
#   postgresql://postgres:postgres@127.0.0.1:5432/tennis_hub_test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tennis_hub_test

# Keep external integrations disabled/mocked in local tests unless a dedicated
# sandbox is explicitly configured.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=test-webhook-token

REDIS_URL=redis://localhost:6379/1
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Safety checklist before running billing/PCI tests:
# 1. Confirm DATABASE_URL host is localhost or 127.0.0.1.
# 2. Confirm database name is disposable, for example tennis_hub_test.
# 3. Confirm DATABASE_URL does not contain railway, rlwy, proxy, production,
#    staging, tennis.app.br, or any remote host.
# 4. Run only after the database above exists and is isolated.
