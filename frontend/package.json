{
  "name": "tenfy-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "serve -s dist --listen tcp://0.0.0.0:${PORT:-4173}",
    "lint": "eslint . --ext ts,tsx",
    "start": "serve -s dist --listen tcp://0.0.0.0:${PORT:-4173}",
    "test:e2e": "playwright test",
    "test:e2e:prod": "PLAYWRIGHT_BASE_URL=https://www.tennis.app.br playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report playwright-report"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-is": "^19.2.5",
    "react-router-dom": "^6.23.1",
    "recharts": "^3.8.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "serve": "^14.2.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.3",
